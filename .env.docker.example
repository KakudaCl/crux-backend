# Docker Compose Environment Variables
# このファイルを .env にコピーして使用してください
#
# ローカル: このまま使用（未設定時は Docker Hub のイメージを使用）
# AWS: 下記のイメージ変数を設定すると ECR 公開イメージを使用してビルド・起動できます

# --- AWS で ECR 公開イメージを使う場合（任意） ---
# POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-alpine
# PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.11-slim

# PostgreSQL Configuration
POSTGRES_USER=crux_user
POSTGRES_PASSWORD=crux_password
POSTGRES_DB=crux_db
POSTGRES_PORT=5432

# API Configuration
API_PORT=8000

# Application Configuration
APP_NAME="CRUX Backend API"
APP_VERSION="0.1.0"
DEBUG=True

# API Settings
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
